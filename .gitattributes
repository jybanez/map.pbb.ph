# Stable runtime bytes across Windows/Linux checkouts and shell integrity manifests.
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf
# Preserve the original scientific runtime's independently pinned byte checksums.
vendor/geomagnetism/** -text -eol whitespace=-trailing-space,cr-at-eol

# Pinned license bytes must survive archive/checkout without Git conversion.
vendor/maplibre/4.6.0/LICENSE.txt -text -eol
vendor/helpers/README.md -text -eol
vendor/helpers/licenses/*.txt -text -eol
